<div class="hero mb-4">
  <h1 class="display-5">We inn Peg Vapes</h1>
  <p class="lead">Winnipeg's local vape shop - kits, tanks, coils and e-liquids for adult customers.</p>
  <%= link_to "Shop all products", products_path, class: "btn btn-warning" %>
</div>

<h2 class="h4">Shop by category</h2>
<div class="row g-3 mb-4">
  <% @categories.each do |c| %>
    <div class="col-6 col-md-3">
      <%= link_to category_path(c), class: "text-decoration-none" do %>
        <div class="card text-center h-100"><div class="card-body"><strong><%= c.name %></strong>
        <div class="small text-muted"><%= pluralize(c.products.count, "product") %></div></div></div>
      <% end %>
    </div>
  <% end %>
</div>

<h2 class="h4">Newest arrivals</h2>
<div class="row g-3">
  <%= render partial: "shared/product_card", collection: @featured, as: :product %>
</div>
