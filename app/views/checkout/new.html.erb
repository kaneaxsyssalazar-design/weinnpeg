<h1 class="h3">Checkout</h1>
<% if @customer.errors.any? %>
  <div class="alert alert-danger"><ul class="mb-0">
    <% @customer.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
  </ul></div>
<% end %>
<%= form_with model: @customer, url: checkout_path, class: "row g-3 bg-white p-3 rounded" do |f| %>
  <div class="col-md-6"><%= f.label :first_name, class: "form-label" %><%= f.text_field :first_name, class: "form-control" %></div>
  <div class="col-md-6"><%= f.label :last_name, class: "form-label" %><%= f.text_field :last_name, class: "form-control" %></div>
  <div class="col-12"><%= f.label :email, class: "form-label" %><%= f.email_field :email, class: "form-control" %></div>
  <div class="col-12"><%= f.label :address, class: "form-label" %><%= f.text_field :address, class: "form-control" %></div>
  <div class="col-md-5"><%= f.label :city, class: "form-label" %><%= f.text_field :city, class: "form-control" %></div>
  <div class="col-md-4"><%= f.label :province_id, "Province", class: "form-label" %>
    <%= f.collection_select :province_id, @provinces, :id, :name, { prompt: "Choose..." }, class: "form-select" %></div>
  <div class="col-md-3"><%= f.label :postal_code, class: "form-label" %><%= f.text_field :postal_code, class: "form-control", placeholder: "R3C 0A1" %></div>
  <div class="col-12"><%= f.submit "Place order", class: "btn btn-warning" %></div>
<% end %>
