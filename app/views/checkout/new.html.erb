<h1 class="h3">Review your order</h1>
<div class="row g-4">
  <div class="col-lg-8">
    <table class="table bg-white">
      <thead><tr><th>Product</th><th>Unit price</th><th>Qty</th><th class="text-end">Line total</th></tr></thead>
      <tbody>
        <% @order.order_items.each do |item| %>
          <tr><td><%= item.product.name %></td><td><%= money(item.unit_price) %></td>
              <td><%= item.quantity %></td><td class="text-end"><%= money(item.line_total) %></td></tr>
        <% end %>
      </tbody>
    </table>
    <%= render "shared/totals", subtotal: @order.subtotal, gst: @order.gst_amount, pst: @order.pst_amount,
                                hst: @order.hst_amount, total: @order.total_amount %>
  </div>
  <div class="col-lg-4">
    <div class="card"><div class="card-body">
      <h2 class="h6">Ship to</h2>
      <p class="mb-1"><strong><%= current_user.full_name %></strong></p>
      <p><%= @order.shipping_address %></p>
      <%= link_to "Change address", edit_user_registration_path, class: "btn btn-sm btn-outline-dark mb-3" %>
      <p class="small text-muted">Taxes shown are for <%= @order.province.name %>.</p>
      <%= button_to "Place order", checkout_path, method: :post, class: "btn btn-warning w-100" %>
    </div></div>
  </div>
</div>